""" rules for scraps counting """

rule assign_sites_R1:
  input:
    "{results}/{sample}/{sample}_R1_Aligned.sortedByCoord.out.bam"
  output:
    bam = temp("{results}/temp/{sample}_R1_assigned.bam")
  params:
    job_name = "assign_sites_R1",
    out = "{results}/temp/{sample}_R1_assigned",
    out_bam = "{results}/temp/{sample}_R1_filter.bam.featureCounts.bam",
    temp = "{results}/temp/{sample}_R1_filter.bam",
    sort_tmp = "{results}/temp/{sample}_R1_sortstage"
  log:
    "{results}/logs/assign_sites_{sample}_R1.txt"
  threads:
    12
  resources:
    mem_mb = 28000
  shell:
    r"""
    if echo {POLYA_SITES} | tr '[:upper:]' '[:lower:]' | grep -q -e "\.saf$" -e "\.saf.gz$"; then
      polyaformat='SAF'; else
      polyaformat='GTF';
    fi
    
    samtools view -@ {threads} -b -e '[CB]!="-" && [UB]!="-"' {input} > {params.temp}

    featureCounts \
    -s 2 -Q 10 -O \
    --read2pos 5 \
    -o {params.out} \
    -F $polyaformat \
    -a {POLYA_SITES} \
    -R BAM \
    -T {threads} \
    {params.temp} \
    2> {log}

    samtools sort \
    -@ {threads} \
    -m 2G \
    -T {params.sort_tmp} \
    --write-index \
    -o {output.bam}##idx##{output.bam}.bai \
    {params.out_bam}

    rm -rf {params.out_bam} {params.sort_tmp}*
    """

rule assign_sites_R2:
  input:
    "{results}/temp/{sample}_R2.bam"
  output:
    bam = temp("{results}/temp/{sample}_R2_assigned.bam")
  params:
    job_name = "assign_sites_R2",
    out = "{results}/temp/{sample}_R2_assigned",
    out_bam = "{results}/temp/{sample}_R2.bam.featureCounts.bam",
    sort_tmp = "{results}/temp/{sample}_R2_sortstage"
  log:
    "{results}/logs/assign_sites_{sample}_R2.txt"
  threads:
    12
  resources:
    mem_mb = 28000
  shell:
    r"""
    if echo {POLYA_SITES} | tr '[:upper:]' '[:lower:]' | grep -q -e "\.saf$" -e "\.saf.gz$"; then
      polyaformat='SAF'; else
      polyaformat='GTF';
    fi

    featureCounts \
    -s 1 -Q 10 -O \
    --read2pos 3 \
    -o {params.out} \
    -F $polyaformat \
    -a {POLYA_SITES} \
    -R BAM \
    -T {threads} \
    {input} \
    2> {log}
    
    samtools sort \
    -@ {threads} \
    -m 2G \
    -T {params.sort_tmp} \
    --write-index \
    -o {output.bam}##idx##{output.bam}.bai \
    {params.out_bam}

    rm -rf {params.out_bam} {params.sort_tmp}*
    """

rule assign_sites_paired:
  input:
    "{results}/{sample}/{sample}_paired_Aligned.sortedByCoord.out.bam"
  output:
    bam = temp("{results}/temp/{sample}_paired_assigned.bam")
  params:
    job_name = "assign_sites_paired",
    out = "{results}/temp/{sample}_paired_assigned",
    out_bam = "{results}/temp/{sample}_paired_filter.bam.featureCounts.bam",
    temp = "{results}/temp/{sample}_paired_filter.bam",
    sort_tmp = "{results}/temp/{sample}_paired_sortstage"
  log:
    "{results}/logs/assign_sites_{sample}_paired.txt"
  threads:
    12
  resources:
    mem_mb = 28000
  shell:
    r"""
    if echo {POLYA_SITES} | tr '[:upper:]' '[:lower:]' | grep -q -e "\.saf$" -e "\.saf.gz$"; then
      polyaformat='SAF'; else
      polyaformat='GTF';
    fi

    samtools view -@ {threads} -b -e '[CB]!="-" && [UB]!="-"' {input} > {params.temp}
    
    featureCounts \
    -s 2 -Q 10 -O -p \
    --read2pos 5 \
    -o {params.out} \
    -F $polyaformat \
    -a {POLYA_SITES} \
    -R BAM \
    -T {threads} \
    {params.temp} \
    2> {log}

    samtools sort \
    -@ {threads} \
    -m 2G \
    -T {params.sort_tmp} \
    --write-index \
    -o {output.bam}##idx##{output.bam}.bai \
    {params.out_bam}

    rm -rf {params.out_bam} {params.sort_tmp}*
    rm -rf {params.temp}
    """
    
rule filter_R2:
  input:
    "{results}/{sample}/{sample}_R2_Aligned.sortedByCoord.out.bam"
  output:
    temp("{results}/temp/{sample}_R2.bam")
  params:
    job_name = "filter",
    temp = "{results}/temp/{sample}_R2_filter.bam"
  log:
    "{results}/logs/filter_{sample}_R2.txt"
  threads:
    4
  resources:
    mem_mb = 8000
  shell:
    r"""
    # No samtools index needed: filter_bam.py reads via fetch(until_eof=True)
    # (linear scan) and the {output} _R2.bam is consumed only by
    # assign_sites_R2's featureCounts, which streams. Indexing either BAM was a
    # wasted full read pass over a potentially very large (500GB+) file.
    samtools view -@ {threads} -b -e '[CB]!="-" && [UB]!="-"' {input} > {params.temp}
    python3 inst/scripts/filter_bam.py -i {params.temp} -o {output}
    rm -rf {params.temp}
    """

rule count:
  # directional UMI count per (cell, site), replacing `umi_tools count`. Groups
  # reads by (CB, featureCounts XT) and collapses distinct UMIs with umi_tools'
  # own directional network algorithm, per-site; parallel over contigs.
  input:
    "{results}/temp/{sample}_{read}_assigned.bam"
  output:
    "{results}/counts/{sample}_{read}_counts.tsv.gz"
  params:
    job_name = "count"
  log:
    "{results}/logs/count_{sample}_{read}.txt"
  threads:
    4
  resources:
    mem_mb = 8000
  shell:
    r"""
    python3 inst/scripts/count_sites.py \
      -i {input} \
      -o {output} \
      -t {threads} \
      2> {log}
    """

# NOTE on bed_* semantics (all modes): pileup_sites.py deduplicates on
# (cell, UMI, priming position) and reports the priming end. Unlike the former
# umi_tools dedup + genomecov, it ignores the opposite-end / fragmentation /
# splice coordinate, so PCR duplicates of one molecule (which differ only at the
# post-amplification fragmentation end) collapse to a single count. This is
# consistent with the count table and reduces bed signal ~3.7% vs the legacy
# pipeline on test data. Intended change; see docs and tests/validate_synthetic.sh.
rule bed_R1:
  # unique-UMI 5' priming pileup direct from the assigned BAM (proper-pair read1
  # when paired-aligned), replacing umi_tools dedup + genomecov
  # (see inst/scripts/pileup_sites.py)
  input:
    "{results}/temp/{sample}_R1_assigned.bam"
  output:
    "{results}/bed/{sample}_R1.bed.gz"
  params:
    job_name = "bed"
  log:
    "{results}/logs/bed_{sample}_R1.txt"
  threads:
    4
  resources:
    mem_mb = 4000
  shell:
    r"""
    python3 inst/scripts/pileup_sites.py \
      -i {input} -o {output} --end 5 --mode R1 2> {log}
    """

rule bed_R2:
  input:
    "{results}/temp/{sample}_R2_assigned.bam"
  output:
    "{results}/bed/{sample}_R2.bed.gz"
  params:
    job_name = "bed"
  log:
    "{results}/logs/bed_{sample}_R2.txt"
  threads:
    4
  resources:
    mem_mb = 4000
  shell:
    r"""
    python3 inst/scripts/pileup_sites.py \
      -i {input} -o {output} --end 3 --mode R2 2> {log}
    """

rule bed_paired:
  input:
    "{results}/temp/{sample}_paired_assigned.bam"
  output:
    "{results}/bed/{sample}_paired.bed.gz"
  params:
    job_name = "bed"
  log:
    "{results}/logs/bed_{sample}_paired.txt"
  threads:
    4
  resources:
    mem_mb = 4000
  shell:
    r"""
    python3 inst/scripts/pileup_sites.py \
      -i {input} -o {output} --end 5 --mode paired 2> {log}
    """
